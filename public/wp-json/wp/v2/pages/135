-accordion-icon bdt-flex-align-right\" aria-hidden=\"true\">\n\n                                                                            <span class=\"bdt-ep-accordion-icon-closed\">\n                                            <i aria-hidden=\"true\" class=\"fa-fw ti ti-plus\"><\/i>                                        <\/span>\n                                    \n                                                                            <span class=\"bdt-ep-accordion-icon-opened\">\n                                            <i aria-hidden=\"true\" class=\"fa-fw ti ti-minus\"><\/i>                                        <\/span>\n                                    \n                                <\/span>\n                            \n                            <span class=\"bdt-ep-title-text bdt-flex bdt-flex-middle\">\n\n                                                                What types of accounts can be linked for Overdraft Protection Sweeps?                            <\/span>\n\n                        <\/div>\n                        <div class=\"bdt-ep-accordion-content bdt-accordion-content\">\n                            <p>You can link multiple types of accounts, including savings, checking, or other business accounts, to provide a robust safety net against overdrafts.<\/p>                        <\/div>\n                    <\/div>\n                                    <div class=\"bdt-ep-accordion-item\">\n                        <div class=\"bdt-ep-accordion-title bdt-accordion-title bdt-flex bdt-flex-middle bdt-flex-between\" id=\"bdt-ep-accordion-how-do-i-enroll-in-online-and-mobile-banking\" data-accordion-index=\"2\" data-title=\"how-do-i-enroll-in-online-and-mobile-banking\" role=\"heading\">\n\n                                                            <span class=\"bdt-ep-accordion-icon bdt-flex-align-right\" aria-hidden=\"true\">\n\n                                                                            <span class=\"bdt-ep-accordion-icon-closed\">\n                                            <i aria-hidden=\"true\" class=\"fa-fw ti ti-plus\"><\/i>                                        <\/span>\n                                    \n                                                                            <span class=\"bdt-ep-accordion-icon-opened\">\n                                            <i aria-hidden=\"true\" class=\"fa-fw ti ti-minus\"><\/i>                                        <\/span>\n                                    \n                                <\/span>\n                            \n                            <span class=\"bdt-ep-title-text bdt-flex bdt-flex-middle\">\n\n                                                                How do I enroll in online and mobile banking?                            <\/span>\n\n                        <\/div>\n                        <div class=\"bdt-ep-accordion-content bdt-accordion-content\">\n                            <p>Enrolling in online and mobile banking is simple. Visit our website or download the HugoCrest Bank mobile app, and follow the prompts to create your account. If you need assistance, our customer service team is available to help you get set up.<\/p>                        <\/div>\n                    <\/div>\n                                    <div class=\"bdt-ep-accordion-item\">\n                        <div class=\"bdt-ep-accordion-title bdt-accordion-title bdt-flex bdt-flex-middle bdt-flex-between\" id=\"bdt-ep-accordion-what-should-i-do-if-i-suspect-fraud-on-my-account\" data-accordion-index=\"3\" data-title=\"what-should-i-do-if-i-suspect-fraud-on-my-account\" role=\"heading\">\n\n                                                            <span class=\"bdt-ep-accordion-icon bdt-flex-align-right\" aria-hidden=\"true\">\n\n                                                                            <span class=\"bdt-ep-accordion-icon-closed\">\n                                            <i aria-hidden=\"true\" class=\"fa-fw ti ti-plus\"><\/i>                                        <\/span>\n                                    \n                                                                            <span class=\"bdt-ep-accordion-icon-opened\">\n                                            <i aria-hidden=\"true\" class=\"fa-fw ti ti-minus\"><\/i>                                        <\/span>\n                                    \n                                <\/span>\n                            \n                            <span class=\"bdt-ep-title-text bdt-flex bdt-flex-middle\">\n\n                                                                What should I do if I suspect fraud on my account?                            <\/span>\n\n                        <\/div>\n                        <div class=\"bdt-ep-accordion-content bdt-accordion-content\">\n                            <p>If you suspect fraud on your account, immediately contact HugoCrest Bank\u2019s customer service or your relationship manager. We will take the necessary steps to secure your account and investigate any unauthorized transactions.<\/p>                        <\/div>\n                    <\/div>\n                                    <div class=\"bdt-ep-accordion-item\">\n                        <div class=\"bdt-ep-accordion-title bdt-accordion-title bdt-flex bdt-flex-middle bdt-flex-between\" id=\"bdt-ep-accordion-can-i-customize-the-transfer-thresholds-for-overdraft-protection-sweeps\" data-accordion-index=\"4\" data-title=\"can-i-customize-the-transfer-thresholds-for-overdraft-protection-sweeps\" role=\"heading\">\n\n                                                            <span class=\"bdt-ep-accordion-icon bdt-flex-align-right\" aria-hidden=\"true\">\n\n                                                                            <span class=\"bdt-ep-accordion-icon-closed\">\n                                            <i aria-hidden=\"true\" class=\"f